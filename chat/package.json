{
  "name": "egig-sideagent-chat",
  "private": true,
  "description": "Bundles the sideagent chat widget into static/js/sideagent-chat.js for the Hugo site.",
  "scripts": {
    "build": "esbuild main.jsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=../static/js/sideagent-chat.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sideagent": "^0.13.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
